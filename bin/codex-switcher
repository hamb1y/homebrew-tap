#!/usr/bin/env bash
set -euo pipefail
umask 077

# File credentials only. Never read or print credential values in the shell.
SWITCHER_CODEX_DIR="${CODEX_DIR:-${CODEX_HOME:-$HOME/.codex}}"
AUTH_FILE="${CODEX_AUTH_FILE:-$SWITCHER_CODEX_DIR/auth.json}"
STORE_DIR="${CODEX_SWITCHER_DIR:-$HOME/.codex-switcher}"
SWITCHER_PYTHON=python3
LOGIN_TMP=""
cleanup() { if [[ -n "$LOGIN_TMP" ]]; then rm -rf -- "$LOGIN_TMP"; fi; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
  cat <<EOF
Usage: codex-switcher [menu|save [LABEL] [--replace]|switch [ID]|login [LABEL]|list|status|delete [ID]]

Without LABEL/ID, Gum supplies an interactive picker. Scripted operations do not need Gum.
Profiles: $STORE_DIR
Active file credentials: $AUTH_FILE
Use cli_auth_credentials_store = "file" in Codex config.toml. Keyrings are not switched.
EOF
}
need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1" >&2; exit 1; }; }

# Keep atomic credential I/O, path validation and locking in one standard-library backend.
backend() {
  "$SWITCHER_PYTHON" - "$STORE_DIR" "$AUTH_FILE" "$@" <<'PY'
import contextlib, fcntl, hashlib, json, os, pathlib, re, stat, sys, tempfile, uuid
store, active = map(pathlib.Path, sys.argv[1:3])
action, *args = sys.argv[3:]
os.umask(0o077)
def check_path(path):
    for part in (path, *path.parents):
        if part.is_symlink(): raise ValueError('symlink paths are not supported')
def directory(path):
    check_path(path)
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    if path.stat().st_uid != os.getuid(): raise ValueError('directory must be owned by current user')
    path.chmod(0o700)
def account_id(value):
    if not re.fullmatch(r'[a-z0-9][a-z0-9._-]{0,79}', value) or value in ('.', '..'):
        raise ValueError('invalid account ID')
    return value
def read_file(path):
    check_path(path)
    if not stat.S_ISREG(path.stat().st_mode): raise ValueError('auth must be a regular file')
    if path.stat().st_size > 1024*1024: raise ValueError('auth file is too large')
    return path.read_bytes()
def auth(path):
    data = read_file(path)
    obj = json.loads(data)
    if not isinstance(obj, dict) or not obj: raise ValueError('auth must be a nonempty JSON object')
    if not (isinstance(obj.get('OPENAI_API_KEY'), str) and obj['OPENAI_API_KEY']) and not (isinstance(obj.get('tokens'), dict) and isinstance(obj['tokens'].get('access_token'), str) and obj['tokens']['access_token']):
        raise ValueError('auth lacks an API key or access token')
    return data
def atomic(path, data):
    check_path(path)
    directory(path.parent)
    fd, temporary = tempfile.mkstemp(prefix='.switcher-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as file:
            file.write(data); file.flush(); os.fsync(file.fileno())
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError): os.unlink(temporary)
def names():
    return sorted(p.name for p in accounts.iterdir() if p.is_dir() and not p.is_symlink() and (p/'auth.json').is_file())
def digest(data): return hashlib.sha256(data).digest()
def label(path):
    check_path(path/'label')
    return (path/'label').read_text().splitlines()[0] if (path/'label').exists() else path.name
def backup(path):
    if path.exists(): atomic(backups/('auth.'+uuid.uuid4().hex+'.json'), read_file(path))
try:
    directory(store)
    accounts, backups = store/'accounts', store/'backups'
    directory(accounts); directory(backups)
    check_path(store/'.lock')
    with (store/'.lock').open('a') as lock:
        os.chmod(store/'.lock', 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        if action == 'save':
            title, source, replace = args
            if not title or len(title) > 80 or any(ord(c)<32 or c in '|\x7f' for c in title): raise ValueError('label must be 1-80 printable characters without |')
            ident = re.sub(r'[^a-z0-9._-]+', '-', title.lower()).strip('-')
            ident = account_id(ident)
            dest = accounts/ident
            check_path(dest)
            data = auth(pathlib.Path(source))
            if dest.exists() and replace != 'yes': raise ValueError('account exists; pass --replace to replace it')
            if dest.exists() and (dest/'auth.json').exists(): backup(dest/'auth.json')
            directory(dest)
            atomic(dest/'auth.json', data)
            atomic(dest/'label', (title+'\n').encode())
            print('Saved: '+ident)
        elif action == 'switch':
            ident = account_id(args[0]); source = accounts/ident/'auth.json'
            data = auth(source)
            check_path(active)
            backup(active)
            atomic(active, data)
            print('Switched: '+ident)
        elif action == 'delete':
            ident = account_id(args[0]); source = accounts/ident
            check_path(source)
            if not source.is_dir(): raise ValueError('account does not exist')
            os.rename(source, backups/('deleted.'+ident+'.'+uuid.uuid4().hex))
            print('Moved to backups: '+ident)
        elif action in ('list', 'status', 'choices'):
            current = auth(active) if action != 'choices' and active.exists() else None
            if action == 'status': print('Auth: '+str(active)+'\nStore: '+str(store))
            if action != 'choices': print('Active\tName\tID')
            for ident in names():
                saved = accounts/ident
                if action == 'choices': print(ident)
                else: print(('yes' if current is not None and digest(auth(saved/'auth.json')) == digest(current) else '')+'\t'+label(saved)+'\t'+ident)
        else: raise ValueError('unknown operation')
except (ValueError, OSError, json.JSONDecodeError, IndexError) as error:
    # Never include parser input or credential values in diagnostics.
    print('codex-switcher: '+('invalid auth JSON' if isinstance(error, json.JSONDecodeError) else str(error)), file=sys.stderr)
    sys.exit(1)
PY
}

pick_id() {
  need gum
  local choices
  choices="$(backend choices)"
  [[ -n "$choices" ]] || { echo 'No saved accounts.' >&2; return 1; }
  printf '%s\n' "$choices" | gum choose --header 'Account ID'
}
pick_label() { need gum; gum input --header 'Account label' --char-limit 80; }
save_account() {
  local label="${1:-}" replace=no
  [[ -n "$label" ]] || { label="$(pick_label)" || return 0; }
  [[ -n "$label" ]] || return 0
  if [[ "${2:-}" == '--replace' ]]; then replace=yes
  elif [[ -n "${2:-}" ]]; then usage >&2; return 2; fi
  backend save "$label" "$AUTH_FILE" "$replace"
}
switch_account() {
  local ident="${1:-}"
  [[ -n "$ident" ]] || { ident="$(pick_id)" || return 0; }
  [[ -n "$ident" ]] || return 0
  backend switch "$ident"
}
delete_account() {
  local ident="${1:-}"
  if [[ -z "$ident" ]]; then
    ident="$(pick_id)" || return 0
    gum confirm "Move account '$ident' to backups?" || return 0
  fi
  [[ -n "$ident" ]] || return 0
  backend delete "$ident"
}
login_account() {
  need codex
  need gum
  local label="${1:-}" mode key
  [[ -n "$label" ]] || { label="$(pick_label)" || return 0; }
  [[ -n "$label" ]] || return 0
  mode="$(gum choose 'Browser' 'Device code' 'API key')" || return 0
  [[ -n "$mode" ]] || return 0
  # Initialize/validate the private store before creating temporary credentials.
  backend choices >/dev/null
  LOGIN_TMP="$(mktemp -d "$STORE_DIR/login.XXXXXXXX")"
  # Copy policy/config for workspace restrictions and login endpoints, never credentials.
  if [[ -f "$SWITCHER_CODEX_DIR/config.toml" ]]; then cp "$SWITCHER_CODEX_DIR/config.toml" "$LOGIN_TMP/config.toml"; fi
  case "$mode" in
    'API key')
      key="$(gum input --password --header 'OpenAI API key')" || return 0
      [[ -n "$key" ]] || return 0
      printf '%s\n' "$key" | env CODEX_HOME="$LOGIN_TMP" codex -c 'cli_auth_credentials_store="file"' login --with-api-key || return 1
      unset key ;;
    'Device code') env CODEX_HOME="$LOGIN_TMP" codex -c 'cli_auth_credentials_store="file"' login --device-auth || return 1 ;;
    Browser) env CODEX_HOME="$LOGIN_TMP" codex -c 'cli_auth_credentials_store="file"' login || return 1 ;;
    *) return 0 ;;
  esac
  backend save "$label" "$LOGIN_TMP/auth.json" no
  echo 'New login saved. Use switch to activate it.'
}
main() {
  case "${1:-}" in -h|--help|help) usage; return ;; --version) echo 'codex-switcher 0.2.0'; return ;; esac
  need "$SWITCHER_PYTHON"
  local command="${1:-menu}"
  if [[ $# -gt 0 ]]; then shift; fi
  if [[ "$command" == menu ]]; then
    need gum
    command="$(gum choose switch save login list status delete Quit)" || return 0
    [[ "$command" != Quit && -n "$command" ]] || return 0
  fi
  case "$command" in
    save) [[ $# -le 2 ]] || { usage >&2; return 2; }; save_account "$@" ;;
    switch|delete|login) [[ $# -le 1 ]] || { usage >&2; return 2; }; "${command}_account" "$@" ;;
    list|status) [[ $# -eq 0 ]] || { usage >&2; return 2; }; backend "$command" ;;
    *) usage >&2; return 2 ;;
  esac
}
main "$@"
